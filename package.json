{
  "name": "pi-typesafe-jev",
  "version": "0.1.0",
  "description": "pi extension that exposes TypeSafe (Jev) System One judgments as four typed tools with a persistent private API key",
  "type": "module",
  "license": "MIT",
  "author": "LegacyBridge Code Agent <zai@legacybridge.tech>",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "typesafe",
    "jev",
    "system-one"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"tests/*.test.ts\"",
    "check": "npm run typecheck && npm run test",
    "pack:dry-run": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "22.19.19",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}
